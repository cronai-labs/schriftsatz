# Build output — reproducible, never committed.
# One ignored directory, deletable in full: `make clean` removes it.
build/
output/
*.pdf

# LaTeX intermediates
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# Python
__pycache__/
*.pyc
.venv/
venv/

# macOS
.DS_Store

# Test artefacts
tests/tmp/

# Node (commitlint is installed on demand in CI, never committed)
node_modules/
package-lock.json

# goreleaser output
dist/

# MegaLinter writes its reports here
megalinter-reports/

# Core dumps. The amd64 MegaLinter image segfaults under emulation on Apple
# Silicon and drops one of these in the repository root.
core
core.*
