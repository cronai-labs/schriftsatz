#!/usr/bin/env bash
# schriftsatz — Markdown to print-ready PDF via pandoc and XeLaTeX.
set -euo pipefail

VERSION="0.1.0"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  cat <<'HELP_END'
schriftsatz — Markdown to print-ready PDF via pandoc and XeLaTeX

USAGE
  schriftsatz [options] <input.md>     build a PDF
  schriftsatz verify <file.pdf>        check that the PDF's text layer is faithful

OPTIONS
  -o, --output FILE    Output path (default: <input>.pdf, next to the input)
      --style FILE     LaTeX header to include (repeatable).
                       Default: styles/text-layer.tex + styles/linebreaking.tex
      --no-default-style  Use only the --style files you pass
      --lang CODE      Document language, e.g. de-DE, en-GB (default: en-GB)
      --capacity N     Characters per table line for the width filter
                       (default 80; lower for narrower type areas)
      --keep-tex       Also write the intermediate .tex next to the output
  -h, --help           This message
      --version        Print version

ENVIRONMENT
  SCHRIFTSATZ_STYLE    Default style file, overrides the built-in default

EXIT CODES
  0 ok · 2 bad arguments · 3 missing dependency · 4 build failure
HELP_END
}

die() { printf 'schriftsatz: %s\n' "$1" >&2; exit "${2:-2}"; }

# — preflight ————————————————————————————————————————————
preflight() {
  local missing=0
  if ! command -v pandoc >/dev/null 2>&1; then
    printf 'schriftsatz: pandoc not found\n' >&2
    printf '  macOS:  brew install pandoc\n  Debian: sudo apt install pandoc\n' >&2
    missing=1
  fi
  if ! command -v xelatex >/dev/null 2>&1; then
    printf 'schriftsatz: xelatex not found\n' >&2
    printf '  macOS:  brew install --cask basictex\n' >&2
    printf '  Debian: sudo apt install texlive-xetex texlive-latex-recommended\n' >&2
    missing=1
  fi
  [ "$missing" -eq 0 ] || exit 3

  local have want
  have="$(pandoc --version | head -1 | awk '{print $2}')"
  want="2.17"
  if [ "$(printf '%s\n%s\n' "$want" "$have" | sort -V | head -1)" != "$want" ]; then
    die "pandoc >= $want required for the table-width filter (found $have)" 3
  fi
}

# — verify: check a PDF's text layer ——————————————————————————
# The project's whole claim is that a PDF can look right and extract wrong. That
# check lived only in the test suite, wired to this repository's own fixtures, so
# a user could not run it against their own document. Now they can.
verify_pdf () {
  local pdf="${1:-}"
  [ -n "$pdf" ] || die "usage: schriftsatz verify <file.pdf>"
  [ -f "$pdf" ] || die "not found: $pdf"
  command -v pdftotext >/dev/null || die "pdftotext (poppler) is required for verify" 3

  local poppler rc=0
  poppler="$(pdftotext "$pdf" - 2>/dev/null)"

  # The defect's signature is a Private Use Area codepoint in the text layer:
  # the glyph is mapped faithfully to a codepoint that means nothing outside the
  # font. poppler DISCARDS those, so they show up as characters that vanished;
  # other extractors keep them and yield mojibake. Detect both.
  # Detecting a Private Use Area codepoint portably is not a job for a shell
  # bracket expression: the range is U+E000-U+F8FF, which is a three-byte UTF-8
  # span, and `grep -P` is a GNU extension this project has already been bitten
  # by. Use python when it is there, and say so plainly when it is not.
  if command -v python3 >/dev/null 2>&1; then
    if printf '%s' "$poppler" | python3 -c '
import sys
t = sys.stdin.read()
hits = sorted({c for c in t if 0xE000 <= ord(c) <= 0xF8FF})
if hits:
    print(" ".join("U+%04X" % ord(c) for c in hits))
    sys.exit(1)
' >/tmp/.ss_pua 2>/dev/null; then
      :
    else
      printf 'FAIL  %s: text layer contains Private Use Area codepoints (%s)\n' \
        "$pdf" "$(cat /tmp/.ss_pua 2>/dev/null)"
      printf '      the font mapped glyphs to codepoints that carry no meaning\n'
      printf '      outside it — see docs/inter-calt-tounicode.md\n'
      rc=1
    fi
    rm -f /tmp/.ss_pua
  else
    printf 'note  python3 absent; skipped the Private Use Area check\n'
  fi

  # Cross-check with a second extractor when one is available. Disagreement is
  # the tell: poppler dropping a character while pypdf keeps a PUA codepoint is
  # exactly the failure this project documents.
  local pyrun=""
  if command -v uv >/dev/null 2>&1; then pyrun="uv run --quiet --with pypdf python"
  elif python3 -c 'import pypdf' >/dev/null 2>&1; then pyrun="python3"; fi
  if [ -n "$pyrun" ]; then
    local second
    second="$($pyrun - "$pdf" 2>/dev/null <<'PY'
import sys
from pypdf import PdfReader
print("".join(p.extract_text() for p in PdfReader(sys.argv[1]).pages))
PY
)"
    local a b
    a="$(printf '%s' "$poppler" | tr -d '[:space:]')"
    b="$(printf '%s' "$second"  | tr -d '[:space:]')"
    if [ "$a" != "$b" ]; then
      printf 'FAIL  %s: extractors disagree (poppler vs pypdf)\n' "$pdf"
      printf '      a PDF whose text layer depends on the reader is not a text layer\n'
      rc=1
    else
      printf 'ok    two extractors agree\n'
    fi
  else
    printf 'note  only one extractor available; install uv for a cross-check\n'
  fi

  [ "$rc" -eq 0 ] && printf 'ok    %s: text layer is faithful\n' "$pdf"
  return "$rc"
}

# — arguments ————————————————————————————————————————————
if [ "${1:-}" = "verify" ]; then shift; verify_pdf "${1:-}"; exit $?; fi

IN=""; OUT=""; LANG_CODE="en-GB"; CAPACITY=""; KEEP_TEX=0; NO_DEFAULT=0
STYLES=()

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)    usage; exit 0 ;;
    --version)    printf 'schriftsatz %s\n' "$VERSION"; exit 0 ;;
    -o|--output)  [ $# -ge 2 ] || die "--output needs a value"; OUT="$2"; shift 2 ;;
    --style)      [ $# -ge 2 ] || die "--style needs a value"; STYLES+=("$2"); shift 2 ;;
    --no-default-style) NO_DEFAULT=1; shift ;;
    --lang)       [ $# -ge 2 ] || die "--lang needs a value"; LANG_CODE="$2"; shift 2 ;;
    --capacity)   [ $# -ge 2 ] || die "--capacity needs a value"; CAPACITY="$2"; shift 2 ;;
    --keep-tex)   KEEP_TEX=1; shift ;;
    --)           shift; [ $# -ge 1 ] || die "no input file after --"; IN="$1"; shift; break ;;
    -*)           die "unknown option: $1" ;;
    *)            [ -z "$IN" ] || die "more than one input file given"; IN="$1"; shift ;;
  esac
done

[ -n "$IN" ] || { usage >&2; exit 2; }
[ -f "$IN" ] || die "input not found: $IN"

preflight

# Output goes next to the INPUT, never into the tool's own directory.
if [ -z "$OUT" ]; then OUT="${IN%.*}.pdf"; fi
outdir="$(dirname "$OUT")"
[ -d "$outdir" ] || mkdir -p "$outdir"

# — styles ————————————————————————————————————————————————
if [ "${#STYLES[@]}" -eq 0 ] && [ "$NO_DEFAULT" -eq 0 ]; then
  if [ -n "${SCHRIFTSATZ_STYLE:-}" ]; then
    STYLES=("$SCHRIFTSATZ_STYLE")
  else
    STYLES=("$HERE/styles/text-layer.tex" "$HERE/styles/linebreaking.tex")
  fi
fi

# Every array expansion below is written ${a[@]+"${a[@]}"}. bash 3.2 — which is
# what /usr/bin/env bash still resolves to on a stock macOS — treats an EMPTY
# array as unset, so a bare "${a[@]}" aborts under `set -u` with
# "args[@]: unbound variable". Reachable here via --no-default-style with no
# --style, which leaves args empty.
args=()
for s in ${STYLES+"${STYLES[@]}"}; do
  [ -f "$s" ] || die "style file not found: $s"
  args+=(-H "$s")
done
[ -n "$CAPACITY" ] && args+=(-M "table-capacity=$CAPACITY")

if ! pandoc "$IN" \
      --pdf-engine=xelatex \
      --lua-filter "$HERE/filters/table-widths.lua" \
      --lua-filter "$HERE/filters/linebreaks.lua" \
      -V "lang=$LANG_CODE" \
      -V fontsize=11pt \
      -V documentclass=article \
      -V indent=false \
      ${args[@]+"${args[@]}"} \
      -o "$OUT"; then
  die "pandoc/xelatex failed building $IN" 4
fi

if [ "$KEEP_TEX" -eq 1 ]; then
  pandoc "$IN" -s -t latex \
    --lua-filter "$HERE/filters/table-widths.lua" \
    --lua-filter "$HERE/filters/linebreaks.lua" \
    -V "lang=$LANG_CODE" ${args[@]+"${args[@]}"} -o "${OUT%.pdf}.tex"
fi

printf '%s\n' "$OUT"
